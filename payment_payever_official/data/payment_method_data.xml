<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Generic payever method so the provider appears at checkout before the
        merchant syncs specific methods from their payever account.
    -->
    <record id="payment_method_payever" model="payment.method">
        <field name="name">payever</field>
        <field name="code">payever</field>
        <field name="sequence">1</field>
        <field name="image" type="base64" file="payment_payever_official/static/description/icon.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">partial</field>
        <field name="support_manual_capture">partial</field>
    </record>

</odoo>
